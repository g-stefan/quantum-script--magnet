{
    "version": 4,
    "configurations": [
        {
            "name": "Win32",
            "intelliSenseMode": "msvc-x64",
            "includePath": [
                "${workspaceRoot}/source",
                "${workspaceRoot}/output/include",
                "${env:USERPROFILE}/.fabricare/win64-msvc-2026/include"
            ],
            "defines": [
                "XYO_PLATFORM_OS_WINDOWS",
                "XYO_PLATFORM_COMPILER_MSVC",
                "XYO_PLATFORM_64BIT",
                "XYO_PLATFORM_MULTI_THREAD"
            ],
            "browse": {
                "path": [
                    "${workspaceRoot}/source",
                    "${workspaceRoot}/output/include",
                    "${env:USERPROFILE}/.fabricare/win64-msvc-2026/include"
                ],
                "limitSymbolsToIncludedHeaders": true,
                "databaseFilename": ""
            },
            "cStandard": "c11",
            "cppStandard": "c++17"
        },
        {
            "name": "linux",
            "intelliSenseMode": "gcc-x64",
            "includePath": [
                "${workspaceRoot}/source",
                "${workspaceRoot}/output/include",
                "${env:HOME}/.fabricare/ubuntu-26.04/include"
            ],
            "defines": [
                "XYO_PLATFORM_OS_LINUX",
                "XYO_PLATFORM_COMPILER_GCC",
                "XYO_PLATFORM_64BIT",
                "XYO_PLATFORM_MULTI_THREAD"
            ],
            "browse": {
                "path": [
                    "${workspaceRoot}/source",
                    "${workspaceRoot}/output/include",
                    "${env:HOME}/.fabricare/ubuntu-26.04/include"
                ],
                "limitSymbolsToIncludedHeaders": true,
                "databaseFilename": ""
            },
            "cStandard": "c11",
            "cppStandard": "c++17"
        }
    ]
}
